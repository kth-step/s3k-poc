option('nproc', type : 'integer', value : 9, yield : true)
option('nhart', type : 'integer', value : 1, yield : true)
option('nslot', type : 'integer', value : 200, yield : true)
option('ntick', type : 'integer', value : 1000, yield : true)
option('npmp',  type : 'integer', value : 8, yield : true)
option('nchan', type : 'integer', value : 8, yield : true)
option('ncap',  type : 'integer', value : 32, yield : true)
option('platform', type : 'combo', choices : ['qemu_virt', 'cheshire'], value : 'qemu_virt', yield : true)
